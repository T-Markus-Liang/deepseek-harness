{
  "name": "dsh-subagent-orchestrator",
  "version": "0.1.0",
  "description": "Role-based subagent routing, model policy, migration, and observability for DeepSeek Harness.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": {
      "default": "./client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "README.md",
    "CHANGELOG.md",
    "cordis.patch.yml",
    "LICENSE",
    "test/orchestrator.test.mjs"
  ],
  "scripts": {
    "test": "node --test test/orchestrator.test.mjs",
    "check": "node --check index.js && node --check client.js && npm test"
  },
  "engines": {
    "node": ">=22.13"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-settings": ">=0.1.0-rc.6 || >=0.1.1-rc.0",
    "@deepseek-ai/schemastery": ">=0.1.0-rc.6 || >=0.1.1-rc.0",
    "react": ">=18"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "external": ["react"],
      "platform": "web"
    }
  }
}
